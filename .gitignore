# ===========================
#  Umbra — .gitignore
# ===========================

# Compiled Java bytecode — never commit these.
# They are generated by javac and differ per machine.
*.class

# Package files — not needed without Maven/Gradle
*.jar
*.war

# IDE-specific folders — these are personal to your setup,
# other contributors shouldn't receive them.
.idea/          # IntelliJ
*.iml           # IntelliJ module files
.vscode/        # VS Code
.project        # Eclipse
.classpath      # Eclipse

# OS clutter
.DS_Store       # macOS
Thumbs.db       # Windows

# Output files generated by Umbra at runtime.
# Raw data belongs in the repo; generated results do not.
output/
*.csv